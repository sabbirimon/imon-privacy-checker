# bin/deploy.sh — copy to .env and fill in. .env is gitignored.
# Variables are read via `set -a; . .env; set +a` so any shell that
# runs deploy.sh inherits them.

# ─── SSH / rsync deploy ──────────────────────────────────────────
# WP_ROOT=/var/www/wordpress
# WP_USER=www-data
# WP_HOST=you@your-server.com
# WP_SITE_URL=https://your-site.com

# ─── FTP / free-host deploy (InfinityFree, 000webhost, AwardSpace) ──
# Get these from the host's cPanel or FTP welcome email.
# FTP_HOST=ftpupload.net
# FTP_USER=epiz_12345678
# FTP_PASS=your-ftp-password
# FTP_PLUGIN_DIR=/htdocs/wp-content/plugins
# WP_SITE_URL=https://your-domain.infinityfreeapp.com

# ─── Production safety ───────────────────────────────────────────
# Leave PRIVACY_CHECKER_DEV_MODE unset (or empty) for prod.
# Set to 1 only when running against a mock-data sandbox.
# PRIVACY_CHECKER_DEV_MODE=
